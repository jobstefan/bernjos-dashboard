// Prisma schema — https://pris.ly/d/prisma-schema
// Prisma 7: the connection URL lives in prisma.config.ts (for the CLI/Migrate),
// and the runtime PrismaClient connects through a driver adapter (see src/lib/db.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  super_admin
  admin
  manager
  employee
}

/// Application user, linked 1:1 to a Clerk user via `clerkId`. Every Clerk user
/// (admin, manager, or employee) gets exactly one row, created on first login.
/// Role is the DB-owned source of truth for RBAC — Clerk handles auth only.
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique @map("clerk_id")
  /// Nullable — employees who log in with username only may have no email.
  email     String?  @unique
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  imageUrl  String?  @map("image_url")
  role      Role     @default(employee)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile UserProfile?

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// Payroll domain
// ─────────────────────────────────────────────────────────────────────────────

enum EmploymentStatus {
  active
  inactive
  resigned
  terminated
}

enum PayFrequency {
  semi_monthly
  monthly
}

enum PayrollStatus {
  draft
  calculated
  pending_approval
  approved
  paid
}

enum RunItemStatus {
  included
  excluded
}

enum CashAdvanceStatus {
  pending
  approved
  declined
  applied
  cancelled
}

enum ChargeStatus {
  pending
  applied
}

enum LoanStatus {
  pending
  approved
  active      // disbursed — repayments created and running
  completed   // all installments collected
  cancelled
}

enum IncentiveStatus {
  pending
  applied
  cancelled
}

enum AbsenceRequestStatus {
  pending
  approved
  declined
}

/// HR/payroll profile for a user who is on the payroll (employee or manager role).
/// Linked 1:1 to `User` via `userId`. Only users with a profile appear in
/// payroll runs, schedules, and attendance.
model UserProfile {
  id                String           @id @default(cuid())
  userId            String?          @unique @map("user_id")
  user              User?            @relation(fields: [userId], references: [id])
  /// Auto-generated login name (first-name initials + last name) handed to the
  /// user. Stored here for admin display and username-collision checks.
  username          String?          @unique @map("username")
  employeeCode      String           @unique @map("employee_code")
  firstName         String           @map("first_name")
  lastName          String           @map("last_name")
  middleName        String?          @map("middle_name")
  position          String
  department        String
  employmentStatus  EmploymentStatus @default(active) @map("employment_status")
  dateHired         DateTime         @map("date_hired") @db.Date
  /// Daily basic-pay rate. Period gross = daily rate × days worked.
  basicSalary       Decimal          @map("basic_salary") @db.Decimal(12, 2)
  payFrequency      PayFrequency     @default(semi_monthly) @map("pay_frequency")
  sssNumber         String?          @map("sss_number")
  philhealthNumber  String?          @map("philhealth_number")
  /// Declared monthly salary used ONLY for the SSS bracket lookup (often lower
  /// than actual pay to reduce the contribution). Null = fall back to gross.
  sssSalaryBasis    Decimal?         @map("sss_salary_basis") @db.Decimal(12, 2)
  /// Fixed PhilHealth employee amount deducted per period. 0 (or null) means the
  /// user does not contribute — no PhilHealth deduction appears on the payslip.
  philhealthAmount  Decimal?         @default(0) @map("philhealth_amount") @db.Decimal(12, 2)
  contactNumber     String?          @map("contact_number")
  address           String?
  bankName          String?          @map("bank_name")
  bankAccountNumber String?          @map("bank_account_number")
  deletedAt         DateTime?        @map("deleted_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  runItems          PayrollRunItem[]
  cashAdvances      CashAdvance[]
  charges           Charge[]
  incentives        Incentive[]
  scheduleEntries   ScheduleEntry[]
  absenceRequests   AbsenceRequest[]
  savingsAccount    SavingsAccount?
  loans             Loan[]
  devices           EmployeeDevice[]
  attendanceRecords AttendanceRecord[]

  @@index([employmentStatus])
  @@index([department])
  @@map("user_profiles")
}

/// SSS contribution schedule. One row per MSC salary bracket; a new set of rows
/// is inserted (with a later `effectiveDate`) whenever SSS updates its rates.
model StatutorySssBracket {
  id             String   @id @default(cuid())
  effectiveDate  DateTime @map("effective_date") @db.Date
  minSalary      Decimal  @map("min_salary") @db.Decimal(12, 2)
  maxSalary      Decimal  @map("max_salary") @db.Decimal(12, 2)
  monthlyCredit  Decimal  @map("monthly_credit") @db.Decimal(12, 2)
  employeeShare  Decimal  @map("employee_share") @db.Decimal(6, 4)
  employerShare  Decimal  @map("employer_share") @db.Decimal(6, 4)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([effectiveDate])
  @@map("statutory_sss_brackets")
}

/// PhilHealth premium schedule. One row per effective period (bracketed by
/// salary floor/ceiling). The employee pays half of `rate`.
model StatutoryPhilhealthBracket {
  id              String   @id @default(cuid())
  effectiveDate   DateTime @map("effective_date") @db.Date
  minSalary       Decimal  @map("min_salary") @db.Decimal(12, 2)
  maxSalary       Decimal  @map("max_salary") @db.Decimal(12, 2)
  rate            Decimal  @db.Decimal(6, 4)
  minContribution Decimal  @map("min_contribution") @db.Decimal(12, 2)
  maxContribution Decimal  @map("max_contribution") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([effectiveDate])
  @@map("statutory_philhealth_brackets")
}

/// A payroll period (cut-off). Groups the per-user run items.
model PayrollPeriod {
  id          String        @id @default(cuid())
  periodLabel String        @map("period_label")
  periodStart DateTime      @map("period_start") @db.Date
  periodEnd   DateTime      @map("period_end") @db.Date
  payDate     DateTime      @map("pay_date") @db.Date
  frequency   PayFrequency
  status      PayrollStatus @default(draft)
  createdBy   String        @map("created_by")
  approvedBy  String?       @map("approved_by")
  approvedAt  DateTime?     @map("approved_at")
  paidBy      String?       @map("paid_by")
  paidAt      DateTime?     @map("paid_at")
  notes       String?
  deletedAt   DateTime?     @map("deleted_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  runItems            PayrollRunItem[]
  cashAdvances        CashAdvance[]
  charges             Charge[]
  incentives          Incentive[]
  savingsTransactions SavingsTransaction[]
  loanRepayments      LoanRepayment[]

  @@index([status])
  @@map("payroll_periods")
}

/// One row per user profile per payroll period. Immutable once the period is approved.
model PayrollRunItem {
  id                  String        @id @default(cuid())
  payrollPeriodId     String        @map("payroll_period_id")
  profileId           String        @map("profile_id")
  basicSalary         Decimal       @map("basic_salary") @db.Decimal(12, 2)
  grossPay            Decimal       @map("gross_pay") @db.Decimal(12, 2)
  sssEmployee         Decimal       @map("sss_employee") @db.Decimal(12, 2)
  philhealthEmployee  Decimal       @map("philhealth_employee") @db.Decimal(12, 2)
  lateDeduction       Decimal       @default(0) @map("late_deduction") @db.Decimal(12, 2)
  advanceDeduction    Decimal       @default(0) @map("advance_deduction") @db.Decimal(12, 2)
  otherDeductions     Decimal       @default(0) @map("other_deductions") @db.Decimal(12, 2)
  loanDeduction       Decimal       @default(0) @map("loan_deduction") @db.Decimal(12, 2)
  chargeDeduction     Decimal       @default(0) @map("charge_deduction") @db.Decimal(12, 2)
  otherEarnings       Decimal       @default(0) @map("other_earnings") @db.Decimal(12, 2)
  incentiveEarnings   Decimal       @default(0) @map("incentive_earnings") @db.Decimal(12, 2)
  /// User savings contribution held out of net pay. NOT a deduction — it's the
  /// user's own money moved into their savings account. Kept separate from
  /// `totalDeductions`: netPay = grossPay − totalDeductions − savingsContribution.
  savingsContribution Decimal       @default(0) @map("savings_contribution") @db.Decimal(12, 2)
  totalDeductions     Decimal       @map("total_deductions") @db.Decimal(12, 2)
  netPay              Decimal       @map("net_pay") @db.Decimal(12, 2)
  status              RunItemStatus @default(included)
  notes               String?
  /// Free-text remark added by an admin, surfaced on the user's payslip.
  remarks             String?
  deletedAt           DateTime?     @map("deleted_at")
  createdAt           DateTime      @default(now()) @map("created_at")

  period   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  profile  UserProfile   @relation(fields: [profileId], references: [id])
  branches PayrollRunItemBranch[]

  @@unique([payrollPeriodId, profileId])
  @@index([profileId])
  @@map("payroll_run_items")
}

/// Snapshot of how a run item's net (take-home) pay splits across the branches the
/// user worked at in the period, allocated proportionally to days worked there.
/// Lets admins pull each user's cash from the branch that incurred it during payroll.
/// A null `branchId` buckets days whose branch couldn't be resolved ("Unassigned").
model PayrollRunItemBranch {
  id         String  @id @default(cuid())
  runItemId  String  @map("run_item_id")
  branchId   String? @map("branch_id")
  daysWorked Decimal @map("days_worked") @db.Decimal(6, 2)
  netPay     Decimal @map("net_pay") @db.Decimal(12, 2)

  runItem PayrollRunItem @relation(fields: [runItemId], references: [id], onDelete: Cascade)
  branch  Branch?        @relation(fields: [branchId], references: [id])

  @@index([runItemId])
  @@map("payroll_run_item_branches")
}

/// Immutable audit trail: who did what, when, with before/after snapshots.
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String   @map("actor_id")
  actorEmail  String?  @map("actor_email")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

/// A user's cash-advance request. Once approved it is deducted in full from
/// the user's next calculated payroll period (into `PayrollRunItem.otherDeductions`).
model CashAdvance {
  id              String            @id @default(cuid())
  profileId       String            @map("profile_id")
  amount          Decimal           @db.Decimal(12, 2)
  /// Amount the approver granted; may differ from the requested `amount`. Null until approved.
  approvedAmount  Decimal?          @map("approved_amount") @db.Decimal(12, 2)
  reason          String
  status          CashAdvanceStatus @default(pending)
  /// Clerk user id of the user who made the request.
  requestedBy     String            @map("requested_by")
  /// Clerk user id of the approver (admin/manager) who acted on it.
  decidedBy       String?           @map("decided_by")
  decidedAt       DateTime?         @map("decided_at")
  /// Approval note or decline reason.
  decisionNote    String?           @map("decision_note")
  /// The payroll period this advance was deducted in, once applied.
  appliedPeriodId String?           @map("applied_period_id")
  appliedAt       DateTime?         @map("applied_at")
  deletedAt       DateTime?         @map("deleted_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  profile       UserProfile    @relation(fields: [profileId], references: [id])
  appliedPeriod PayrollPeriod? @relation(fields: [appliedPeriodId], references: [id])

  @@index([profileId])
  @@index([status])
  @@map("cash_advances")
}

/// An admin-imposed charge (penalty, shortage, error deduction) applied to an
/// employee's next payroll run. No approval needed — created and immediately
/// pending. Swept into `PayrollRunItem.chargeDeduction` on the next calculation.
model Charge {
  id              String       @id @default(cuid())
  profileId       String       @map("profile_id")
  branchId        String       @map("branch_id")
  amount          Decimal      @db.Decimal(12, 2)
  reason          String
  status          ChargeStatus @default(pending)
  createdBy       String       @map("created_by")
  appliedPeriodId String?      @map("applied_period_id")
  appliedAt       DateTime?    @map("applied_at")
  deletedAt       DateTime?    @map("deleted_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  profile       UserProfile    @relation(fields: [profileId], references: [id])
  branch        Branch         @relation(fields: [branchId], references: [id])
  appliedPeriod PayrollPeriod? @relation(fields: [appliedPeriodId], references: [id])

  @@index([profileId])
  @@index([branchId])
  @@index([status])
  @@map("charges")
}

// ─────────────────────────────────────────────────────────────────────────────
// Organization domain (curated departments & positions)
// ─────────────────────────────────────────────────────────────────────────────

/// A curated department. The managed source for the department names shown on the
/// profile form. `UserProfile.department` remains a plain string that stores the
/// chosen name (not a foreign key), so legacy free-text values keep working.
model Department {
  id        String    @id @default(cuid())
  name      String    @unique
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  positions Position[]

  @@map("departments")
}

/// A job position nested under a department. Names are unique within their
/// department. Like departments, this feeds the profile form's dropdown while
/// `UserProfile.position` stays a plain string.
model Position {
  id           String    @id @default(cuid())
  name         String
  departmentId String    @map("department_id")
  shiftHours   Int       @default(8) @map("shift_hours")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, name])
  @@index([departmentId])
  @@map("positions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Daily schedule domain
// ─────────────────────────────────────────────────────────────────────────────

/// A work location. Kept intentionally lightweight (name + optional address) so
/// schedule entries can reference a branch without over-modeling locations yet.
model Branch {
  id        String    @id @default(cuid())
  name      String
  address   String?
  /// Adapter key identifying this branch's biometric export format (e.g.
  /// "zkteco-v1"). Null = attendance uploads not configured for this branch.
  attendanceFormat String? @map("attendance_format")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  scheduleEntries    ScheduleEntry[]
  employeeDevices    EmployeeDevice[]
  attendanceImports  AttendanceImport[]
  payrollBranchItems PayrollRunItemBranch[]
  charges            Charge[]
  loans              Loan[]
  incentives         Incentive[]

  @@map("branches")
}

/// One user's schedule for a single day. Exactly one row per (date, profile);
/// the absence of a row for a day means that user is OFF that day.
model ScheduleEntry {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  profileId String   @map("profile_id")
  branchId  String?  @map("branch_id")
  /// Shift start/end as `HH:MM` 24-hour strings.
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  note      String?
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile UserProfile @relation(fields: [profileId], references: [id])
  branch  Branch?     @relation(fields: [branchId], references: [id])

  @@unique([date, profileId])
  @@index([date])
  @@map("schedule_entries")
}

/// A user's request to be absent (unpaid day off) on a specific date.
/// Pending or approved requests block the user from being scheduled that day.
/// Declined requests have no scheduling effect.
model AbsenceRequest {
  id           String               @id @default(cuid())
  profileId    String               @map("profile_id")
  date         DateTime             @db.Date
  reason       String?
  status       AbsenceRequestStatus @default(pending)
  /// Clerk user id of whoever created the request (user or admin).
  requestedBy  String               @map("requested_by")
  /// Clerk user id of the admin who approved or declined.
  decidedBy    String?              @map("decided_by")
  decidedAt    DateTime?            @map("decided_at")
  decisionNote String?              @map("decision_note")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  profile UserProfile @relation(fields: [profileId], references: [id])

  @@unique([profileId, date])
  @@index([date])
  @@index([status])
  @@map("absence_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
// Savings domain (user support system)
// ─────────────────────────────────────────────────────────────────────────────

/// A user's savings account. This is an internal "support system" — the
/// user's own money, held for them. `contributionAmount` is the recurring
/// amount pulled from each payroll run (into `PayrollRunItem.savingsContribution`,
/// never a deduction). Savings is mandatory: every payroll user has exactly one
/// account and the contribution is always at least ₱100.
model SavingsAccount {
  id                 String   @id @default(cuid())
  profileId          String   @unique @map("profile_id")
  /// Recurring amount contributed per payroll period (minimum ₱100).
  contributionAmount Decimal  @default(100) @map("contribution_amount") @db.Decimal(12, 2)
  createdBy          String   @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  profile      UserProfile          @relation(fields: [profileId], references: [id])
  transactions SavingsTransaction[]

  @@map("savings_accounts")
}

/// The savings ledger. Balance = sum of transaction amounts. Contributions are
/// positive and carry an `appliedPeriodId` (created by the payroll run); admin
/// withdrawals/adjustments are recorded here too (withdrawals negative).
model SavingsTransaction {
  id              String   @id @default(cuid())
  accountId       String   @map("account_id")
  /// "contribution" | "withdrawal" | "adjustment"
  type            String
  /// Signed peso amount: contributions +, withdrawals −.
  amount          Decimal  @db.Decimal(12, 2)
  note            String?
  /// Set for payroll-driven contributions; links the ledger row to the period.
  appliedPeriodId String?  @map("applied_period_id")
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  account       SavingsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  appliedPeriod PayrollPeriod? @relation(fields: [appliedPeriodId], references: [id])

  @@index([accountId])
  @@index([appliedPeriodId])
  @@map("savings_transactions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Loan domain (borrowing against savings balance)
// ─────────────────────────────────────────────────────────────────────────────

/// An employee loan, capped at the employee's accumulated savings balance.
/// Repaid via automatic payroll deductions (LoanRepayment installments).
/// Savings balance is never reduced — savings pay out at year-end separately.
model Loan {
  id           String     @id @default(cuid())
  profileId    String     @map("profile_id")
  branchId     String?    @map("branch_id")
  amount       Decimal    @db.Decimal(12, 2)
  /// Number of pay periods chosen to repay over (1–4).
  termPeriods  Int        @map("term_periods")
  reason       String
  status       LoanStatus @default(pending)
  /// Clerk user id of whoever created the request (employee or admin on their behalf).
  requestedBy  String     @map("requested_by")
  decidedBy    String?    @map("decided_by")
  decidedAt    DateTime?  @map("decided_at")
  decisionNote String?    @map("decision_note")
  disbursedAt  DateTime?  @map("disbursed_at")
  disbursedBy  String?    @map("disbursed_by")
  deletedAt    DateTime?  @map("deleted_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  profile    UserProfile    @relation(fields: [profileId], references: [id])
  branch     Branch?        @relation(fields: [branchId], references: [id])
  repayments LoanRepayment[]

  @@index([profileId])
  @@index([branchId])
  @@index([status])
  @@map("loans")
}

/// One installment per payroll period. Created in bulk when the loan is disbursed (active).
model LoanRepayment {
  id              String    @id @default(cuid())
  loanId          String    @map("loan_id")
  installmentNo   Int       @map("installment_no")
  amount          Decimal   @db.Decimal(12, 2)
  /// "pending" while awaiting payroll deduction; "applied" once the period is approved.
  status          String    @default("pending")
  appliedPeriodId String?   @map("applied_period_id")
  appliedAt       DateTime? @map("applied_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  loan          Loan           @relation(fields: [loanId], references: [id], onDelete: Cascade)
  appliedPeriod PayrollPeriod? @relation(fields: [appliedPeriodId], references: [id])

  @@unique([loanId, installmentNo])
  @@index([loanId])
  @@index([appliedPeriodId])
  @@map("loan_repayments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Incentive domain (admin-granted extra earnings applied to payroll)
// ─────────────────────────────────────────────────────────────────────────────

/// A one-off incentive granted by an admin. Picked up automatically by the
/// next payroll run; status moves from pending → applied at that point.
/// Admins can cancel a pending incentive before it is applied.
model Incentive {
  id          String          @id @default(cuid())
  profileId   String          @map("profile_id")
  branchId    String?         @map("branch_id")
  amount      Decimal         @db.Decimal(12, 2)
  reason      String?
  status      IncentiveStatus @default(pending)
  periodId    String?         @map("period_id")
  createdBy   String          @map("created_by")
  createdAt   DateTime        @default(now()) @map("created_at")
  cancelledBy String?         @map("cancelled_by")
  cancelledAt DateTime?       @map("cancelled_at")

  profile UserProfile    @relation(fields: [profileId], references: [id])
  branch  Branch?        @relation(fields: [branchId], references: [id])
  period  PayrollPeriod? @relation(fields: [periodId], references: [id])

  @@index([profileId])
  @@index([branchId])
  @@index([status])
  @@map("incentives")
}

// ─────────────────────────────────────────────────────────────────────────────
// Attendance domain (biometric imports → schedule vs actual)
// ─────────────────────────────────────────────────────────────────────────────

/// Maps a biometric scanner's enrollment id to a user profile, scoped to a branch.
/// Biometric exports identify people by a device-specific id (not `employeeCode`),
/// and the same person can hold different ids across branch scanners — hence the
/// `(branchId, deviceUserId)` uniqueness rather than a global one.
model EmployeeDevice {
  id           String   @id @default(cuid())
  profileId    String   @map("profile_id")
  branchId     String   @map("branch_id")
  deviceUserId String   @map("device_user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  profile UserProfile @relation(fields: [profileId], references: [id])
  branch  Branch      @relation(fields: [branchId], references: [id])

  @@unique([branchId, deviceUserId])
  @@index([profileId])
  @@map("employee_devices")
}

/// One uploaded biometric Excel file. Tracks processing status and match counts
/// so the import can be reviewed (unmatched ids) and re-run.
model AttendanceImport {
  id            String   @id @default(cuid())
  branchId      String   @map("branch_id")
  /// Adapter key used to parse this file (snapshot of the branch's format).
  format        String
  fileName      String   @map("file_name")
  /// processing | completed | failed
  status        String   @default("processing")
  totalRows     Int      @default(0) @map("total_rows")
  matchedRows   Int      @default(0) @map("matched_rows")
  unmatchedRows Int      @default(0) @map("unmatched_rows")
  errorMessage  String?  @map("error_message")
  /// deviceUserIds present in the file with no EmployeeDevice mapping.
  unmatchedIds  Json?    @map("unmatched_ids")
  uploadedBy    String   @map("uploaded_by")
  createdAt     DateTime @default(now()) @map("created_at")

  branch  Branch             @relation(fields: [branchId], references: [id])
  records AttendanceRecord[]

  @@index([branchId])
  @@map("attendance_imports")
}

/// Normalized *actual* attendance — one row per (date, profile), mirroring
/// `ScheduleEntry`. Compared against the schedule to derive lates/absences.
model AttendanceRecord {
  id        String   @id @default(cuid())
  /// The import this row came from. Null for rows an admin added by hand (a day
  /// the scanner missed) — those have no source file.
  importId  String?  @map("import_id")
  profileId String   @map("profile_id")
  branchId  String?  @map("branch_id")
  date      DateTime @db.Date
  /// Actual clock-in / clock-out as `HH:MM` 24-hour strings (like ScheduleEntry).
  timeIn    String?  @map("time_in")
  timeOut   String?  @map("time_out")
  /// Total mid-shift gap minutes (time punched out between first and last punch).
  /// 0 for a clean day; null when punches don't pair (odd count) and the gap must
  /// be entered manually.
  breakMinutes Int?    @map("break_minutes")
  /// First punch-out time during the shift (`HH:MM`), i.e. when the mid-day gap starts.
  gapStart     String? @map("gap_start")
  /// First punch-back-in time during the shift (`HH:MM`), i.e. when the mid-day gap ends.
  gapEnd       String? @map("gap_end")
  /// Second mid-day gap start — manual add-in only (biometrics only capture one gap).
  gap2Start    String? @map("gap2_start")
  /// Second mid-day gap end — manual add-in only.
  gap2End      String? @map("gap2_end")
  /// "biometric" (parsed from an import) | "manual" (admin edit/override).
  source     String   @default("biometric")
  /// Clerk user id + timestamp of the last manual edit, when `source` is "manual".
  editedBy   String?   @map("edited_by")
  editedAt   DateTime? @map("edited_at")
  /// The original parsed row, kept for audit and to re-derive if rules change.
  /// Null for manually-added rows (no source row).
  rawRow     Json?    @map("raw_row")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  import  AttendanceImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  profile UserProfile       @relation(fields: [profileId], references: [id])

  @@unique([date, profileId])
  @@index([profileId])
  @@map("attendance_records")
}
