// Prisma schema — https://pris.ly/d/prisma-schema
// Prisma 7: the connection URL lives in prisma.config.ts (for the CLI/Migrate),
// and the runtime PrismaClient connects through a driver adapter (see src/lib/db.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Application user, linked 1:1 to a Clerk user via `clerkId`.
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// Payroll domain
// ─────────────────────────────────────────────────────────────────────────────

enum EmploymentStatus {
  active
  inactive
  resigned
  terminated
}

enum PayFrequency {
  semi_monthly
  monthly
}

enum PayrollStatus {
  draft
  calculated
  pending_approval
  approved
  paid
}

enum RunItemStatus {
  included
  excluded
}

enum CashAdvanceStatus {
  pending
  approved
  declined
  applied
  cancelled
}

/// An employee on the payroll. `clerkUserId` links to the Clerk user so an
/// employee can view their own payslips.
model Employee {
  id                String           @id @default(cuid())
  clerkUserId       String?          @unique @map("clerk_user_id")
  employeeCode      String           @unique @map("employee_code")
  firstName         String           @map("first_name")
  lastName          String           @map("last_name")
  middleName        String?          @map("middle_name")
  email             String           @map("email")
  position          String
  department        String
  employmentStatus  EmploymentStatus @default(active) @map("employment_status")
  dateHired         DateTime         @map("date_hired") @db.Date
  /// Daily basic-pay rate. Period gross = daily rate × days worked.
  basicSalary       Decimal          @map("basic_salary") @db.Decimal(12, 2)
  payFrequency      PayFrequency     @default(semi_monthly) @map("pay_frequency")
  sssNumber         String?          @map("sss_number")
  philhealthNumber  String?          @map("philhealth_number")
  bankName          String?          @map("bank_name")
  bankAccountNumber String?          @map("bank_account_number")
  deletedAt         DateTime?        @map("deleted_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  runItems        PayrollRunItem[]
  cashAdvances    CashAdvance[]
  scheduleEntries ScheduleEntry[]

  @@index([employmentStatus])
  @@index([department])
  @@map("employees")
}

/// SSS contribution schedule. One row per MSC salary bracket; a new set of rows
/// is inserted (with a later `effectiveDate`) whenever SSS updates its rates.
model StatutorySssBracket {
  id             String   @id @default(cuid())
  effectiveDate  DateTime @map("effective_date") @db.Date
  minSalary      Decimal  @map("min_salary") @db.Decimal(12, 2)
  maxSalary      Decimal  @map("max_salary") @db.Decimal(12, 2)
  monthlyCredit  Decimal  @map("monthly_credit") @db.Decimal(12, 2)
  employeeShare  Decimal  @map("employee_share") @db.Decimal(6, 4)
  employerShare  Decimal  @map("employer_share") @db.Decimal(6, 4)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([effectiveDate])
  @@map("statutory_sss_brackets")
}

/// PhilHealth premium schedule. One row per effective period (bracketed by
/// salary floor/ceiling). The employee pays half of `rate`.
model StatutoryPhilhealthBracket {
  id              String   @id @default(cuid())
  effectiveDate   DateTime @map("effective_date") @db.Date
  minSalary       Decimal  @map("min_salary") @db.Decimal(12, 2)
  maxSalary       Decimal  @map("max_salary") @db.Decimal(12, 2)
  rate            Decimal  @db.Decimal(6, 4)
  minContribution Decimal  @map("min_contribution") @db.Decimal(12, 2)
  maxContribution Decimal  @map("max_contribution") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([effectiveDate])
  @@map("statutory_philhealth_brackets")
}

/// A payroll period (cut-off). Groups the per-employee run items.
model PayrollPeriod {
  id          String        @id @default(cuid())
  periodLabel String        @map("period_label")
  periodStart DateTime      @map("period_start") @db.Date
  periodEnd   DateTime      @map("period_end") @db.Date
  payDate     DateTime      @map("pay_date") @db.Date
  frequency   PayFrequency
  status      PayrollStatus @default(draft)
  createdBy   String        @map("created_by")
  approvedBy  String?       @map("approved_by")
  approvedAt  DateTime?     @map("approved_at")
  paidBy      String?       @map("paid_by")
  paidAt      DateTime?     @map("paid_at")
  notes       String?
  deletedAt   DateTime?     @map("deleted_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  runItems     PayrollRunItem[]
  cashAdvances CashAdvance[]

  @@index([status])
  @@map("payroll_periods")
}

/// One row per employee per payroll period. Immutable once the period is approved.
model PayrollRunItem {
  id                 String        @id @default(cuid())
  payrollPeriodId    String        @map("payroll_period_id")
  employeeId         String        @map("employee_id")
  basicSalary        Decimal       @map("basic_salary") @db.Decimal(12, 2)
  grossPay           Decimal       @map("gross_pay") @db.Decimal(12, 2)
  sssEmployee        Decimal       @map("sss_employee") @db.Decimal(12, 2)
  philhealthEmployee Decimal       @map("philhealth_employee") @db.Decimal(12, 2)
  otherDeductions    Decimal       @default(0) @map("other_deductions") @db.Decimal(12, 2)
  otherEarnings      Decimal       @default(0) @map("other_earnings") @db.Decimal(12, 2)
  totalDeductions    Decimal       @map("total_deductions") @db.Decimal(12, 2)
  netPay             Decimal       @map("net_pay") @db.Decimal(12, 2)
  status             RunItemStatus @default(included)
  notes              String?
  deletedAt          DateTime?     @map("deleted_at")
  createdAt          DateTime      @default(now()) @map("created_at")

  period   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employee Employee      @relation(fields: [employeeId], references: [id])

  @@unique([payrollPeriodId, employeeId])
  @@index([employeeId])
  @@map("payroll_run_items")
}

/// Immutable audit trail: who did what, when, with before/after snapshots.
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String   @map("actor_id")
  actorEmail  String?  @map("actor_email")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

/// An employee's cash-advance request. Once approved it is deducted in full from
/// the employee's next calculated payroll period (into `PayrollRunItem.otherDeductions`).
model CashAdvance {
  id              String            @id @default(cuid())
  employeeId      String            @map("employee_id")
  amount          Decimal           @db.Decimal(12, 2)
  reason          String
  status          CashAdvanceStatus @default(pending)
  /// Clerk user id of the employee who made the request.
  requestedBy     String            @map("requested_by")
  /// Clerk user id of the approver (admin/manager) who acted on it.
  decidedBy       String?           @map("decided_by")
  decidedAt       DateTime?         @map("decided_at")
  /// Approval note or decline reason.
  decisionNote    String?           @map("decision_note")
  /// The payroll period this advance was deducted in, once applied.
  appliedPeriodId String?           @map("applied_period_id")
  appliedAt       DateTime?         @map("applied_at")
  deletedAt       DateTime?         @map("deleted_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  employee      Employee       @relation(fields: [employeeId], references: [id])
  appliedPeriod PayrollPeriod? @relation(fields: [appliedPeriodId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@map("cash_advances")
}

// ─────────────────────────────────────────────────────────────────────────────
// Daily schedule domain
// ─────────────────────────────────────────────────────────────────────────────

/// A work location. Kept intentionally lightweight (name + optional address) so
/// schedule entries can reference a branch without over-modeling locations yet.
model Branch {
  id        String    @id @default(cuid())
  name      String
  address   String?
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  scheduleEntries ScheduleEntry[]

  @@map("branches")
}

/// One employee's schedule for a single day. Exactly one row per (date, employee);
/// the absence of a row for a day means that employee is OFF that day.
model ScheduleEntry {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  employeeId String   @map("employee_id")
  branchId   String?  @map("branch_id")
  /// Shift start/end as `HH:MM` 24-hour strings.
  startTime  String   @map("start_time")
  endTime    String   @map("end_time")
  note       String?
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])
  branch   Branch?  @relation(fields: [branchId], references: [id])

  @@unique([date, employeeId])
  @@index([date])
  @@map("schedule_entries")
}
