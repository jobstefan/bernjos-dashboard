# Copy this file to `.env` and fill in the values.
#
# THREE ENVIRONMENTS (see docs/deployment.md):
#   - local dev  -> this .env file, pointing at local Docker Postgres
#   - staging    -> values set in the Vercel "Staging" environment (branch: staging)
#   - production -> values set in the Vercel Production environment (branch: main)
# Only local values belong in a file. Staging/production secrets live in Vercel.

# --- Database (Prisma + PostgreSQL) ---
# Local dev uses the Docker Postgres from docker-compose.dev.yml (`pnpm db:local:up`).
#
# Two connection strings in staging/production (set per-environment in Vercel):
#   DATABASE_URL  -> POOLED endpoint  — used by the app at runtime (src/lib/db.ts)
#   DIRECT_URL    -> DIRECT endpoint  — used by migrations (prisma.config.ts) and
#                                       seeds; the Vercel build runs migrate deploy
# Locally, only DATABASE_URL is needed: Docker has no pooler, and migrations/seeds
# fall back to DATABASE_URL when DIRECT_URL is unset.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54332/postgres"
# DIRECT_URL="<neon-direct-url>"   # staging/production only (Vercel)

# --- Clerk (https://dashboard.clerk.com -> API keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: Clerk redirect routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Access control ---
# RBAC dev bypass. Leave unset for the default (on outside production, treats
# every signed-in user as super_admin). Set to "false" to enforce real Clerk
# roles in development; "true" to force the bypass on everywhere.
PAYROLL_RBAC_BYPASS=false

# Password assigned to every user created by `pnpm db:seed:users` (dev only).
SEED_USER_PASSWORD=Bernjos-Dev-2026!

# Temporary password set on the Clerk account provisioned for each new employee
# (Clerk mode only). Handed out by the admin; the employee replaces it during
# first-login onboarding. Defaults to "1234".
EMPLOYEE_TEMP_PASSWORD=1234

# --- Local dev login (bypass Clerk) ---
# When DEV_AUTH=true, the app skips Clerk and uses a simple cookie-based role
# login at /sign-in (pick a role + password). Handy for development so you don't
# need Clerk verification codes. NEVER set this to true in production.
DEV_AUTH=true
DEV_AUTH_PASSWORD=1234

# --- Inngest (https://app.inngest.com) ---
# Not required for local development with the Inngest Dev Server.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
